# Google Gemini (removed once the Microsoft Foundry migration completes)
GEMINI_API_KEY=

# Microsoft Foundry (formerly Azure AI Foundry).
# Set all four to enable AI judging, or none to run on the heuristic judge.
# Setting only some of them is a startup error.
#
# Endpoint: the resource URL, without a trailing path.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# Key: Azure portal -> your resource -> Keys and Endpoint.
AZURE_OPENAI_API_KEY=
# Deployment names, NOT model names. These are what the API calls "model".
AZURE_OPENAI_JUDGE_DEPLOYMENT=
AZURE_OPENAI_BONUS_DEPLOYMENT=
