# Microsoft Foundry (formerly Azure AI Foundry).
# Set all three to enable AI judging, or none to run on the heuristic judge.
# Setting only some of them is a startup error.
#
# There is deliberately no key or secret here. Authentication is Microsoft
# Entra ID via DefaultAzureCredential, which resolves from your `az login`
# session locally and from a managed identity once hosted.
#
# Local setup:
#   az login
# The signed-in identity needs the "Cognitive Services OpenAI User" role
# (or "Foundry User") on the resource.
#
# Either endpoint form works — the /openai/v1 suffix the portal shows is fine,
# and so is the bare host. It is normalised to exactly one /openai/v1.
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
# Deployment names, NOT model names. These are what the API calls "model".
AZURE_OPENAI_JUDGE_DEPLOYMENT=
AZURE_OPENAI_BONUS_DEPLOYMENT=

# Shared store for the daily bonus challenge. Optional.
#
# Leave unset for single-replica running: the in-process cache alone is correct
# when there is only one process. Set it before scaling past one replica, or
# each replica generates and serves its own daily challenge.
#
# Locally, run `npm run azurite` and use the emulator shortcut:
#   DAILY_CHALLENGE_STORAGE=UseDevelopmentStorage=true
#
# In Azure, use the blob endpoint. There is no key: the app authenticates with
# Entra ID, and the identity needs "Storage Blob Data Contributor".
#   DAILY_CHALLENGE_STORAGE=https://yourstorage.blob.core.windows.net
DAILY_CHALLENGE_STORAGE=


# Shared store for multiplayer rooms. Required to serve rooms in production.
#
# A room is shared state with a lifetime, so unlike the daily challenge it
# cannot fall back to a per-process copy: two players in one room can be served
# by different replicas, and an in-memory room would be a different room for
# each of them — and gone entirely the moment the app scales to zero.
#
# The endpoints are therefore only mounted once this question is answered. With
# neither variable set, a production deployment refuses room requests with a 503
# that says so, rather than quietly handing two players two different rooms.
# Development needs neither: it is one process by definition.
#
# Locally, run `npm run azurite` and use the emulator shortcut:
#   ROOM_STORAGE=UseDevelopmentStorage=true
#
# In Azure, use the blob endpoint. There is no key: the app authenticates with
# Entra ID, and the identity needs "Storage Blob Data Contributor" — the same
# role the daily challenge already uses.
#   ROOM_STORAGE=https://yourstorage.blob.core.windows.net
ROOM_STORAGE=

# An explicit promise that this deployment runs exactly ONE replica, and accepts
# losing every live room on restart. Only honoured when ROOM_STORAGE is unset.
#   ROOMS_SINGLE_REPLICA=true
ROOMS_SINGLE_REPLICA=

# Rate limit on POST /api/rooms, the only room endpoint reachable without a seat
# token. Defaults to 10 creations per 10 minutes per client IP; over that the
# request is refused with 429 and a Retry-After header. Joining, polling and
# playing are deliberately NOT limited — polling is how the game is played.
#
# The counter is in-process, so the real ceiling is this number multiplied by the
# replica count. It is a guard against a runaway client, not a quota.
ROOM_CREATE_LIMIT=
ROOM_CREATE_WINDOW_SECONDS=

# How many proxies sit in front of the app, for Express's `trust proxy`.
# Defaults to 1, which is the Container Apps ingress.
#
# This is what makes req.ip the caller instead of the ingress, so it decides
# whether the rate limit above is per visitor or shared by everybody. Setting it
# higher than the number of proxies actually in front of the app is worse than
# leaving it low: callers can then spoof X-Forwarded-For for a fresh bucket per
# request. Use 0 when nothing is in front of the app.
TRUST_PROXY_HOPS=


# Application Insights. Optional; unset means no telemetry is recorded.
#
# Unlike the rest of this file's philosophy, this value is NOT a secret: it is
# write-only telemetry ingestion and grants no read access. Treated as ordinary
# configuration deliberately, not by oversight.
#
# A malformed value degrades to no telemetry rather than failing startup.
APPLICATIONINSIGHTS_CONNECTION_STRING=